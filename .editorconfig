root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,json,yml,manifest}]
indent_size = 2

# As Visual Studio saves it.
[*.sln]
charset = utf-8-bom
indent_style = tab

# Without BOM, Windows PowerShell 5.1 reads scripts as ANSI and mangles non-ASCII.
[*.ps1]
charset = utf-8-bom

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# Third-party code: original encoding.
[src/AC.SteamBridge/SAM.API/**.cs]
charset = utf-8-bom
