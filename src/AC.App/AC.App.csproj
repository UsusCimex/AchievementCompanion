<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AC.App</RootNamespace>
    <AssemblyName>AchievementCompanion</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The helper is a self-contained exe, the app is not; the reference only sets build order. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <!-- ThemeMode (the built-in WPF Fluent theme) is marked experimental: WPF0001. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AC.Infrastructure\AC.Infrastructure.csproj" />
    <!-- Only to build the helper before the app; its assembly is not referenced by the app. -->
    <ProjectReference Include="..\AC.SteamBridge\AC.SteamBridge.csproj" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" OutputItemType="_SteamBridgeOutput" />
  </ItemGroup>

  <!-- Put the AC.SteamBridge helper (x86) in the bridge folder next to the app. -->
  <Target Name="CopySteamBridge" AfterTargets="Build">
    <PropertyGroup>
      <_BridgeDir>@(_SteamBridgeOutput->'%(RootDir)%(Directory)')</_BridgeDir>
      <_BridgeDir Condition="'$(_BridgeDir)' == ''">$(MSBuildThisFileDirectory)..\AC.SteamBridge\bin\$(Configuration)\net10.0\win-x86\</_BridgeDir>
    </PropertyGroup>
    <ItemGroup>
      <_BridgeFiles Include="$(_BridgeDir)**\*.*" Exclude="$(_BridgeDir)publish\**" />
    </ItemGroup>
    <Warning Condition="'@(_BridgeFiles)' == ''" Text="Built AC.SteamBridge not found in $(_BridgeDir). Build the whole solution (AchievementCompanion.sln)." />
    <Copy SourceFiles="@(_BridgeFiles)" DestinationFiles="@(_BridgeFiles->'$(OutDir)bridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Same for dotnet publish: the helper must be in the publish folder too. -->
  <Target Name="PublishSteamBridge" AfterTargets="Publish" DependsOnTargets="CopySteamBridge">
    <Copy SourceFiles="@(_BridgeFiles)" DestinationFiles="@(_BridgeFiles->'$(PublishDir)bridge\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
