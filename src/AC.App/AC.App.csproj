<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AC.App</RootNamespace>
    <AssemblyName>Hundo</AssemblyName>
    <StartupObject>AC.App.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- ThemeMode (the built-in WPF Fluent theme) is marked experimental: WPF0001. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AC.Infrastructure\AC.Infrastructure.csproj" />
  </ItemGroup>
</Project>
