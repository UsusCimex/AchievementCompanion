<Window x:Class="AC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        Title="Achievement Companion"
        Width="1280" Height="800" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="Inverse" />
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    </Window.Resources>

    <DockPanel>
        <!-- Строка состояния -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="12" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Библиотека -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Библиотека" Style="{StaticResource Header}" Margin="0,0,0,4" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Открыть" Margin="6,0,0,0" Command="{Binding LoadAppIdCommand}" />
                        <TextBlock Text="AppID:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding AppIdInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Button Content="Обновить библиотеку из Steam" Margin="0" Command="{Binding RefreshLibraryCommand}" />
                    <CheckBox Content="Переключаться на запущенную игру" Margin="0,6,0,0" IsChecked="{Binding AutoFollow}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding LibraryView}" SelectedItem="{Binding SelectedLibraryGame}"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconUrl}" Width="24" Height="24" Margin="0,0,6,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                        <Run Text="{Binding AppId, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding PlaytimeMinutes, Mode=OneWay}" />
                                        <Run Text=" мин" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

            <!-- Игра -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Оверлей" Click="OnToggleOverlay" ToolTip="Показать или скрыть оверлей (горячая клавиша в настройках)" />
                            <Button Content="Настройки" Click="OnOpenSettings" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding GameTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding ProgressText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding RemainingText}" />
                    <TextBlock Text="{Binding CompletionText}" Style="{StaticResource Muted}" />

                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Время до 100%, ч:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="60" Text="{Binding CompletionInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                        <Button Content="Применить" Command="{Binding ApplyCompletionCommand}" />
                        <Button Content="Взять с completionist.me" Command="{Binding FetchCompletionCommand}" Margin="0,0,18,0" />
                        <TextBlock Text="Реально наиграно, ч:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip="Своё значение вместо времени Steam. Пусто - брать из Steam" />
                        <TextBox Width="60" Text="{Binding PlaytimeOverrideInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" VerticalContentAlignment="Center" />
                        <TextBlock Text="Не считать из Steam, ч:" VerticalAlignment="Center" Margin="0,0,6,0"
                                   ToolTip="Часы до того, как в игру добавили достижения, или AFK. Вычитаются из времени Steam" />
                        <TextBox Width="60" Text="{Binding PlaytimeOffsetInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" VerticalContentAlignment="Center" />
                        <Button Content="Применить" Command="{Binding ApplyPlaytimeCommand}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Обновить статус" Command="{Binding RefreshStateCommand}" ToolTip="Статус из источника, выбранного в настройках (Web API или Steam-клиент)" />
                        <Button Content="Обновить схему" Command="{Binding ReloadCommand}" ToolTip="Перекачать список достижений и глобальные проценты" />
                        <Button Content="Прочитать через Steam-клиент" Command="{Binding ReadViaBridgeCommand}"
                                ToolTip="Работает при скрытом профиле; на пару секунд покажет тебя в игре" />
                        <Button Content="{Binding QueueText}" Command="{Binding FlushQueueCommand}"
                                Visibility="{Binding QueueVisible, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Экспорт..." Click="OnExportMenu">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Не засчитанные - CSV" Command="{Binding ExportCsvCommand}" CommandParameter="manual" />
                                    <MenuItem Header="Не засчитанные - JSON" Command="{Binding ExportJsonCommand}" CommandParameter="manual" />
                                    <Separator />
                                    <MenuItem Header="Все достижения - CSV" Command="{Binding ExportCsvCommand}" CommandParameter="all" />
                                    <MenuItem Header="Все достижения - JSON" Command="{Binding ExportJsonCommand}" CommandParameter="all" />
                                    <Separator />
                                    <MenuItem Header="Сохранить разметку (типы, группы, оценки)" Command="{Binding ExportTagsCommand}" />
                                    <MenuItem Header="Загрузить разметку..." Command="{Binding ImportTagsCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>

                    <WrapPanel Margin="0,8,0,4">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="160" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                        <ComboBox Width="110" Margin="0,0,6,0" ItemsSource="{x:Static local:Options.KindFilters}" SelectedItem="{Binding KindFilter}" />
                        <ComboBox Width="140" Margin="0,0,6,0" ItemsSource="{x:Static local:Options.Sorts}" SelectedItem="{Binding SelectedSort}" />
                        <CheckBox Content="обратно" IsChecked="{Binding Descending}" />
                        <ComboBox Width="120" Margin="0,0,12,0" ItemsSource="{x:Static local:Options.Percentiles}" SelectedItem="{Binding SelectedPercentile}"
                                  ToolTip="Какую оценку времени показывать" />
                        <CheckBox Content="скрыть открытые" IsChecked="{Binding HideDone}" />
                        <CheckBox Content="только не засчитанные" IsChecked="{Binding OnlyManual}" />
                        <CheckBox Content="только секретные" IsChecked="{Binding OnlyHidden}" />
                    </WrapPanel>
                </StackPanel>

                <TabControl>
                    <TabItem Header="Достижения">
                        <DataGrid x:Name="AchievementsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                                  SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#DDD" EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Записать выбранные в Steam (как в SAM)"
                                              Command="{Binding UnlockInSteamCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="Снять это достижение в Steam"
                                              Command="{Binding RevertCommand}"
                                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Достижение" Width="*" MinWidth="220" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4" ToolTip="{Binding Tooltip}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding Badges}" Foreground="#B35C00" FontSize="11"
                                                           Visibility="{Binding Badges, Converter={StaticResource EmptyToCollapsed}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Глоб. %" Binding="{Binding Percent, Mode=OneWay}" Width="62" IsReadOnly="True" />
                                <DataGridTextColumn Header="Время" Binding="{Binding Estimate, Mode=OneWay}" Width="62" IsReadOnly="True" />

                                <DataGridTemplateColumn Header="Своя, ч" IsReadOnly="True" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding EstimateInput, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                                     ToolTip="Своя оценка времени от начала игры, в часах. Пусто - автоматическая" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Тип" IsReadOnly="True" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{x:Static local:Options.Kinds}" DisplayMemberPath="Title" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Группа" IsReadOnly="True" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Group, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                                     ToolTip="Метка &quot;за один заход&quot;: глава, локация, режим" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Сделал" IsReadOnly="True" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsUnlocked, Converter={StaticResource Inverse}}"
                                                      HorizontalAlignment="Center" Margin="0"
                                                      ToolTip="Выполнено, но в Steam не засчиталось" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Steam" IsReadOnly="True" Width="72">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="В Steam" Margin="0" Padding="6,1" VerticalAlignment="Center"
                                                    ToolTip="Записать достижение в Steam сейчас (как в SAM)"
                                                    Command="{Binding DataContext.UnlockInSteamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanWriteToSteam, Converter={StaticResource BoolToVis}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText, Mode=OneWay}" Width="130" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Заметка" IsReadOnly="True" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="План до 100%">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding RemainingText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"
                                           Text="Порядок: сначала миссибл, потом сюжет, прочее и гринд. Внутри этапа - по оценке времени от начала игры. Группы задаются в колонке &quot;Группа&quot;." />
                                <ItemsControl ItemsSource="{Binding PlanSections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Header}" />
                                                <ItemsControl ItemsSource="{Binding Groups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                                                <StackPanel>
                                                                    <TextBlock>
                                                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                                                        <Run Text="   " />
                                                                        <Run Text="{Binding Longest, Mode=OneWay}" Foreground="#666" />
                                                                    </TextBlock>
                                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,3">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="70" />
                                                                                        <ColumnDefinition Width="60" />
                                                                                        <ColumnDefinition Width="80" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Name}" />
                                                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Estimate}" />
                                                                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" />
                                                                                    <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource Muted}" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
