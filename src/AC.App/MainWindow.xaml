<Window x:Class="AC.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        Title="Achievement Companion" Icon="Assets/app.ico"
        Width="1360" Height="880" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Карточка достижения в списке -->
        <DataTemplate x:Key="AchievementCard">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="48" Height="48" CornerRadius="6" VerticalAlignment="Top"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding Icon, Converter={StaticResource UrlToImage}, ConverterParameter=96}" />
                            </Border.Background>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0" ToolTip="{Binding Tooltip}">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0" Style="{StaticResource Muted}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Style="{StaticResource Chip}" Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding KindTitle}" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding Group, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding Group}" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="секрет" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Ставит только сервер игры, записать в Steam нельзя">
                                <TextBlock Text="защищено" Style="{StaticResource ChipText}" />
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsPendingWrite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="в очереди в Steam" Style="{StaticResource ChipText}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" MinWidth="170" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Percent}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RarityText}" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" ToolTip="Оценка времени от начала игры">
                            <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,4,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Estimate}" Style="{StaticResource Caption}" />
                        </StackPanel>

                        <Border CornerRadius="10" Padding="8,2" Margin="0,6,0,0" HorizontalAlignment="Right"
                                Visibility="{Binding StatusText, Converter={StaticResource EmptyToCollapsed}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsManualStatus}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <CheckBox Content="Сделал" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="0"
                                      IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsUnlocked, Converter={StaticResource Inverse}}"
                                      ToolTip="Выполнено, но в Steam не засчиталось" />
                            <Button Content="В Steam" Padding="10,3"
                                    ToolTip="Записать достижение в Steam сейчас (как в SAM)"
                                    Command="{Binding DataContext.UnlockInSteamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding CanWriteToSteam, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Боковая панель: библиотека ===== -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Achievement Companion" Style="{StaticResource Subtitle}" />
                    <TextBlock Text="Помощник для прохождения на 100%" Style="{StaticResource Caption}" Margin="0,2,0,14" />
                    <TextBlock Text="Поиск по библиотеке" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LibraryFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="Открыть по AppID" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Открыть" Margin="8,0,0,0" Command="{Binding LoadAppIdCommand}" />
                        <TextBox Text="{Binding AppIdInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Button HorizontalAlignment="Stretch" Margin="0,0,0,8" Command="{Binding RefreshLibraryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Обновить библиотеку" />
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OnOpenSettings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                            <TextBlock Text="Настройки" />
                        </StackPanel>
                    </Button>
                    <CheckBox Content="Переключаться на запущенную игру" IsChecked="{Binding AutoFollow}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding LibraryView}" SelectedItem="{Binding SelectedLibraryGame}" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="92" Height="43" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding HeaderUrl, Converter={StaticResource UrlToImage}, ConverterParameter=184}" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Caption}" FontSize="11">
                                        <Run Text="{Binding PlaytimeMinutes, Mode=OneWay}" />
                                        <Run Text=" мин в игре" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Основная часть ===== -->
        <Grid Grid.Column="1" Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заглушка, пока игра не выбрана -->
            <StackPanel Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasGame, Converter={StaticResource InverseVis}}">
                <TextBlock Text="&#xE8F1;" Style="{StaticResource Glyph}" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Выбери игру слева" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="или запусти её в Steam - приложение переключится само" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Шапка игры -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="276" Height="129" CornerRadius="6" VerticalAlignment="Top"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding HeaderImageUrl, Converter={StaticResource UrlToImage}, ConverterParameter=552}" />
                            </Border.Background>
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="{Binding GameName}" Style="{StaticResource Title}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="6" Maximum="100" Margin="0,10,0,4" Value="{Binding ProgressPercent, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="Открыто" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding StatUnlocked}" Style="{StaticResource StatValue}" />
                                    <TextBlock Text="{Binding StatUnlockedSub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="До 100%" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding StatRemaining}" Style="{StaticResource StatValue}" />
                                    <TextBlock Text="{Binding StatRemainingSub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RemainingText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="12,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel>
                                    <TextBlock Text="Наиграно" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding StatPlayed}" Style="{StaticResource StatValue}" />
                                    <TextBlock Text="{Binding StatPlayedSub}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Действия -->
            <WrapPanel Grid.Row="1" Margin="0,12,0,4" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding RefreshStateCommand}"
                        ToolTip="Статус из источника, выбранного в настройках (Web API или Steam-клиент)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Обновить статус" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding ReloadCommand}"
                        ToolTip="Перекачать список достижений и глобальные проценты">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Обновить схему" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding ReadViaBridgeCommand}"
                        ToolTip="Прочитать статус через Steam-клиент: работает при скрытом профиле, на пару секунд покажет тебя в игре">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Через Steam-клиент" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Command="{Binding FlushQueueCommand}"
                        Visibility="{Binding QueueVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding QueueText}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Click="OnExportMenu">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Экспорт" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Не засчитанные - CSV" Command="{Binding ExportCsvCommand}" CommandParameter="manual" />
                            <MenuItem Header="Не засчитанные - JSON" Command="{Binding ExportJsonCommand}" CommandParameter="manual" />
                            <Separator />
                            <MenuItem Header="Все достижения - CSV" Command="{Binding ExportCsvCommand}" CommandParameter="all" />
                            <MenuItem Header="Все достижения - JSON" Command="{Binding ExportJsonCommand}" CommandParameter="all" />
                            <Separator />
                            <MenuItem Header="Сохранить разметку (типы, группы, оценки)" Command="{Binding ExportTagsCommand}" />
                            <MenuItem Header="Загрузить разметку..." Command="{Binding ImportTagsCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Margin="0,0,8,8" Padding="12,6" Click="OnToggleOverlay"
                        ToolTip="Показать или скрыть оверлей (горячая клавиша в настройках)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                        <TextBlock Text="Оверлей" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Вкладки -->
            <TabControl Grid.Row="2" Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}">
                <TabItem Header="Достижения">
                    <DockPanel Margin="0,10,0,0">
                        <!-- Фильтры -->
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Поиск" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <TextBox Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Тип" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <ComboBox Width="130" ItemsSource="{x:Static local:Options.KindFilters}" SelectedItem="{Binding KindFilter}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Сортировка" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <ComboBox Width="170" ItemsSource="{x:Static local:Options.Sorts}" SelectedItem="{Binding SelectedSort}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Оценка времени" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <ComboBox Width="140" ItemsSource="{x:Static local:Options.Percentiles}" SelectedItem="{Binding SelectedPercentile}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6" VerticalAlignment="Bottom">
                                <WrapPanel>
                                    <CheckBox Content="обратный порядок" IsChecked="{Binding Descending}" Margin="0,0,12,0" />
                                    <CheckBox Content="скрыть открытые" IsChecked="{Binding HideDone}" Margin="0,0,12,0" />
                                    <CheckBox Content="только не засчитанные" IsChecked="{Binding OnlyManual}" Margin="0,0,12,0" />
                                    <CheckBox Content="только секретные" IsChecked="{Binding OnlyHidden}" />
                                </WrapPanel>
                            </StackPanel>
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <!-- Список -->
                            <ListBox x:Name="AchievementList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                     ItemTemplate="{StaticResource AchievementCard}" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                                     Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Записать выбранные в Steam (как в SAM)"
                                                  Command="{Binding UnlockInSteamCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Снять это достижение в Steam"
                                                  Command="{Binding RevertCommand}"
                                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <!-- Подробности выбранного -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasSelectedRow, Converter={StaticResource InverseVis}}">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="Выбери достижение, чтобы задать тип, группу, оценку и заметку"
                                                   Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedRow}"
                                                  Visibility="{Binding DataContext.HasSelectedRow, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <Border Width="64" Height="64" CornerRadius="8" HorizontalAlignment="Left"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill"
                                                                    ImageSource="{Binding Icon, Converter={StaticResource UrlToImage}, ConverterParameter=128}" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Margin="0,10,0,4" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                                            <ToggleButton Content="Показать описание" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,3"
                                                          IsChecked="{Binding Revealed}"
                                                          Visibility="{Binding IsSpoilerHidden, Converter={StaticResource BoolToVis}}" />

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Получили" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                                    <Run Text="{Binding Percent, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding RarityText, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Grid.Row="1" Text="Оценка" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Estimate}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Text="Статус" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Margin="0,0,0,6" />
                                                <TextBlock Grid.Row="3" Text="API-имя" Style="{StaticResource Caption}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ApiName, Mode=OneWay}" IsReadOnly="True" />
                                            </Grid>

                                            <TextBlock Text="Тип" Style="{StaticResource Caption}" Margin="0,16,0,2" />
                                            <ComboBox ItemsSource="{x:Static local:Options.Kinds}" DisplayMemberPath="Title" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Kind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" />

                                            <TextBlock Text="Группа &quot;за один заход&quot; (глава, локация, режим)" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Group, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Text="Своя оценка, часов от начала игры (пусто - авто)" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding EstimateInput, UpdateSourceTrigger=LostFocus}" />

                                            <TextBlock Text="Заметка" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                                            <TextBox Text="{Binding Note, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />

                                            <WrapPanel Margin="0,16,0,0">
                                                <CheckBox Content="Сделал, но не засчиталось" Margin="0,0,0,8"
                                                          IsChecked="{Binding ManualDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding IsUnlocked, Converter={StaticResource Inverse}}" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <Button Content="Записать в Steam" Margin="0,0,8,8" Padding="12,5"
                                                        Command="{Binding DataContext.UnlockInSteamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanWriteToSteam, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="Снять в Steam" Margin="0,0,8,8" Padding="12,5"
                                                        Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="План до 100%">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Subtitle}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Text="Порядок: сначала миссибл, потом сюжет, прочее и гринд. Внутри этапа - по оценке времени от начала игры. Группы задаются в карточке достижения." />
                            <ItemsControl ItemsSource="{Binding PlanSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Header}" />
                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <DockPanel Margin="0,0,0,6">
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Longest}" Style="{StaticResource Caption}" />
                                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,4">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="80" />
                                                                                    <ColumnDefinition Width="70" />
                                                                                    <ColumnDefinition Width="90" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <StackPanel>
                                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Estimate}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                                                <TextBlock Grid.Column="2" Text="{Binding Percent}" Style="{StaticResource Muted}" />
                                                                                <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource Caption}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Время">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Время до 100%" Style="{StaticResource Subtitle}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="Из него считаются оценки по каждому достижению: чем реже достижение, тем позже его обычно получают. Если не задано, оценка выводится из твоего прогресса." />
                                    <WrapPanel>
                                        <TextBox Width="90" Text="{Binding CompletionInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8" />
                                        <TextBlock Text="часов" VerticalAlignment="Center" Margin="0,0,16,8" Style="{StaticResource Muted}" />
                                        <Button Content="Применить" Margin="0,0,8,8" Command="{Binding ApplyCompletionCommand}" />
                                        <Button Content="Взять с completionist.me" Margin="0,0,8,8" Command="{Binding FetchCompletionCommand}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding CompletionText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Время в игре" Style="{StaticResource Subtitle}" />
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                                               Text="Если много стоял в AFK или достижения добавили в игру позже, поправь, сколько времени реально считать прогрессом." />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Реально наиграно, ч" VerticalAlignment="Center" Margin="0,0,0,8"
                                                   ToolTip="Своё значение вместо времени Steam. Пусто - брать из Steam" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Width="90" Margin="0,0,0,8"
                                                 Text="{Binding PlaytimeOverrideInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Row="1" Text="Не считать из Steam, ч" VerticalAlignment="Center" Margin="0,0,0,8"
                                                   ToolTip="Часы до появления достижений или AFK - вычитаются из времени Steam" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="90" Margin="0,0,0,8"
                                                 Text="{Binding PlaytimeOffsetInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Row="2" Grid.Column="1" Content="Применить" HorizontalAlignment="Left"
                                                Command="{Binding ApplyPlaytimeCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Строка состояния -->
            <DockPanel Grid.Row="3" Margin="0,8,0,0">
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
