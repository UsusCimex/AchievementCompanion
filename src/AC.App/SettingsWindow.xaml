<Window x:Class="AC.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AC.App"
        Title="Настройки" Icon="Assets/app.ico" Width="640" Height="760" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Margin="0,0,8,0" Padding="16,5" />
                <Button Content="Сохранить" IsDefault="True" Click="OnSave" Padding="16,5" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="Настройки" Style="{StaticResource Title}" Margin="0,0,0,12" />

                <!-- Steam -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Steam" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />

                        <TextBlock Text="Web API ключ" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Получить ключ" Margin="8,0,0,0" Click="OnGetKey" />
                            <PasswordBox x:Name="ApiKeyBox" />
                        </DockPanel>

                        <TextBlock Text="SteamID64" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Взять из Steam" Margin="8,0,0,0" Click="OnDetectSteamId" />
                            <TextBox x:Name="SteamIdBox" />
                        </DockPanel>

                        <TextBlock Text="Язык названий и описаний" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="LanguageBox" ItemsSource="{x:Static local:Options.Languages}" HorizontalAlignment="Stretch" />

                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Ключ хранится зашифрованным (Windows DPAPI) в папке данных. На странице ключа в поле домена можно вписать localhost. Для статуса из Web API в приватности Steam должны быть открыты &quot;Сведения об играх&quot;." />
                    </StackPanel>
                </Border>

                <!-- Статус -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Автообновление статуса" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <ComboBox x:Name="StatusSourceBox" ItemsSource="{x:Static local:Options.StatusSources}" HorizontalAlignment="Stretch" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,10"
                                   Text="Статус обновляется сам: когда Steam переписывает файл статистики игры и по таймеру, пока игра запущена. Полученное в игре становится &quot;открыто&quot; без ручной отметки. Без API-ключа всегда используется Steam-клиент." />
                        <TextBlock Text="Опрос статуса во время игры, секунд" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <TextBox x:Name="PollBox" Width="90" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Запись в Steam -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Запись в Steam" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <TextBlock Text="Что делать с галочкой &quot;Сделал&quot;" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="WriteModeBox" ItemsSource="{x:Static local:Options.WriteModes}" HorizontalAlignment="Stretch" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Кнопка &quot;В Steam&quot; у достижения записывает его сразу при любом режиме, как SAM. Запись идёт через помощник на основе SAM.API; время открытия будет временем записи. Защищённые достижения (ставит только сервер игры) записать нельзя. Каждая запись пишется в журнал unlock_log.jsonl." />
                    </StackPanel>
                </Border>

                <!-- Отображение -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Отображение" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <TextBlock Text="Тема" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                        <ComboBox x:Name="ThemeBox" ItemsSource="{x:Static local:Options.Themes}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <CheckBox x:Name="HideSpoilersBox" Content="Прятать описания скрытых достижений, пока они не получены" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="В оверлее описания скрытых видны всегда." />
                    </StackPanel>
                </Border>

                <!-- Оверлей -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Оверлей" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Показать / скрыть" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <TextBox x:Name="ToggleHotkeyBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Режим кликов" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                <TextBox x:Name="InteractHotkeyBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Непрозрачность фона" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                        <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" />
                        <TextBlock Text="Сколько &quot;ближайших&quot; показывать" Style="{StaticResource Caption}" Margin="0,10,0,2" />
                        <TextBox x:Name="NearestBox" Width="90" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Сочетания вида Ctrl+Shift+A. Оверлей виден в оконном и полноэкранном оконном (borderless) режиме игры." />
                    </StackPanel>
                </Border>

                <!-- Данные -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Данные" Style="{StaticResource Subtitle}" Margin="0,0,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Открыть папку" Margin="8,0,0,0" Click="OnOpenDataDir" />
                            <TextBox x:Name="DataDirBox" IsReadOnly="True" />
                        </DockPanel>
                        <TextBlock x:Name="DataDirHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
